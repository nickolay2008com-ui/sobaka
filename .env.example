# Railway Postgres reference variable
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated list of emails allowed to enter /admin
ADMIN_EMAILS=you@example.com

# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_SALT=replace-with-another-random-secret

# Email delivery for admin codes and lead notifications
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Partnership <hello@your-domain.ru>

# Optional absolute public URL (Railway domain), used in service emails
APP_URL=https://your-service.up.railway.app

# Optional public identity
NEXT_PUBLIC_SITE_NAME=Техническое партнёрство
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_ALLY_URL=https://www.allyai.ru
